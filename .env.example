# Copiez ce fichier en .env et ajustez les valeurs.
#   cp .env.example .env

# Obligatoire en production : ≥ 32 caractères aléatoires
JWT_SECRET=change-me-with-32-random-characters-minimum

# LLM : auto | openai | anthropic | openrouter | nvidia | ollama | mock
# mock = moteur déterministe local, aucune clé requise (démo/tests)
LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# NVIDIA NIM — gratuit (~40 req/min, sans quota journalier) : https://build.nvidia.com
NVIDIA_API_KEY=
OLLAMA_HOST=

# Chaîne de repli : si le modèle courant atteint son quota (HTTP 429) ou
# échoue, le moteur bascule automatiquement sur le modèle suivant, puis sur
# la policy locale si toute la chaîne est en cooldown.
# Format :
#   provider:model  un modèle précis     provider        modèle par défaut
#   provider:*      TOUS les modèles utilisables du catalogue, rechargés à
#                   chaque démarrage :
#     - nvidia:*    51 modèles chat sur 85 (embeddings/vision/garde-fous filtrés)
#     - openrouter:* uniquement les 15 modèles :free — gratuité garantie
# Recommandé avec les deux clés gratuites (66 modèles) :
LLM_FALLBACK_CHAIN=nvidia:*,openrouter:*
# Sinon, exemple explicite :
# LLM_FALLBACK_CHAIN=openrouter:google/gemma-4-31b-it:free,nvidia:mistralai/mistral-large-2-instruct
# Cooldown initial après un 429 (double à chaque 429 consécutif, plafonné)
LLM_COOLDOWN_SECONDS=120
LLM_COOLDOWN_MAX_SECONDS=3600

# Embeddings : auto | openai | ollama | local
EMBEDDINGS_PROVIDER=auto

# Email (outil send_email) : vide = l'outil échoue honnêtement
SMTP_URL=
